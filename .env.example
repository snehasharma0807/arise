# ── FastAPI Backend ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
CLAUDE_MODEL=claude-sonnet-4-6
APP_API_KEY=your-secret-app-key-here

# Rate limiting (per IP)
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=30
RATE_LIMIT_PER_DAY=100

# Image processing
MAX_IMAGE_SIZE_MB=5
MAX_IMAGE_DIMENSION=1568

# ── Supabase (backend — server-side only, never expose to frontend) ────────────
# Find these in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret   # Settings → API → JWT Secret

# ── Next.js Frontend (.env.local) ────────────────────────────────────────────
# URL of the running FastAPI backend.
# Local dev:  http://localhost:8000
# Deployed:   https://your-api.railway.app  (or Render/Fly URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# X-API-Key header value sent with every FastAPI request.
# In dev mode (APP_API_KEY empty on server), any non-empty string works.
# In production, match APP_API_KEY exactly.
NEXT_PUBLIC_APP_API_KEY=dev-key

# ── Supabase (frontend — safe to expose, scoped by RLS) ──────────────────────
# Find these in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://wgoaiwwfyklwzzyhxodm.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_LF6tBv4bfbVQgg-ABNZsmA_fGRfh4yj

# ── ElevenLabs (Supabase Edge Function secret — set via CLI) ─────────────────
# NEVER put real keys in this file. Set them with:
#   supabase secrets set ELEVENLABS_API_KEY=sk_...
#
# For local Supabase dev only (supabase/functions/.env):
ELEVENLABS_API_KEY=sk_fe0ddfe99187033e8e3b16643dd2489fb5cf997e681e2cd8

# Optional: override the default Aria voice (9BWtsMINqrJLrRacOk9x)
# ELEVENLABS_VOICE_ID=<alternative-voice-id>

# ── Copy to .env.local for Next.js dev ───────────────────────────────────────
# cp .env.example .env.local
# Then fill in real values. NEVER commit .env.local to git.
